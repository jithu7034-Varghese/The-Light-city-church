# Supabase (Project Settings -> API). Create the project in Jithu's Supabase account.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Server only: never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public site URL (used for emails, sitemap, canonical URLs)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM="The Light City Church <hello@thelightcitychurch.org>"

# Spam protection (Cloudflare Turnstile)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Secret for /api/cron/* (Vercel Cron) and booking manage tokens
CRON_SECRET=
BOOKING_TOKEN_SECRET=
