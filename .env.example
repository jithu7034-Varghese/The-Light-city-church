# Supabase (Project Settings -> API). Create the project in Jithu's Supabase account.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Server only: never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public site URL (used for emails, sitemap, canonical URLs)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Email (Resend). Without RESEND_API_KEY, form emails are logged (email_log status "skipped") instead of sent.
RESEND_API_KEY=
EMAIL_FROM="The Light City Church <hello@thelightcitychurch.org>"
# Who gets "new enquiry" emails when a form has no recipients set (comma-separated)
ENQUIRY_RECIPIENTS=

# Spam protection (Cloudflare Turnstile). Without the secret, the check is skipped (rate limit + honeypot still apply).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Salt for hashing visitor IPs (rate limiting). Any long random string; keep it stable.
IP_HASH_SALT=

# Secret for /api/cron/* (Vercel Cron) and booking manage tokens
CRON_SECRET=
BOOKING_TOKEN_SECRET=
